<?xml version= "1.0" encoding = "utf-8" ?>
<!-- A game in the library grid: the whole icon (never cropped) on a tinted card, the name below. -->
<ru.playsoftware.j2meloader.applist.AppItemLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp"
    tools:showIn="@layout/fragment_apps_list">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:cardCornerRadius="16dp"
        app:contentPadding="12dp">

        <ImageView
            android:id="@+id/list_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:src="@mipmap/ic_launcher" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        tools:text="Example MIDlet Name" />

</ru.playsoftware.j2meloader.applist.AppItemLayout>
